-- GUI Library + your own code in the same LocalScript
-- Put this in e.g. StarterPlayerScripts (or directly in StarterGui as a LocalScript)

--========================================================--
--                     GUI LIBRARY                        --
--   (no need to edit this part, keep scrolling down)     --
--========================================================--

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}
Library.__index = Library

local TOPBAR_HEIGHT = 30
local TABBAR_HEIGHT = 26
local DEFAULT_WIDTH = 220
local DEFAULT_HEIGHT = 220

local function create(className, props)
	local inst = Instance.new(className)
	for prop, value in pairs(props) do
		inst[prop] = value
	end
	return inst
end

function Library.new(title)
	title = title or "Window"

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	-- ScreenGui that holds the entire window
	local screenGui = create("ScreenGui", {
		Name = "CustomLibraryGui",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-- Small black main box
	local mainFrame = create("Frame", {
		Name = "MainFrame",
		Size = UDim2.new(0, DEFAULT_WIDTH, 0, DEFAULT_HEIGHT),
		Position = UDim2.new(0.5, -DEFAULT_WIDTH / 2, 0.5, -DEFAULT_HEIGHT / 2),
		BackgroundColor3 = Color3.fromRGB(20, 20, 20),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = screenGui,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = mainFrame })

	-- Top bar (drag from here, and it always stays visible when the box is collapsed)
	local topBar = create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT),
		BackgroundColor3 = Color3.fromRGB(35, 35, 35),
		BorderSizePixel = 0,
		Parent = mainFrame,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = topBar })
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 1, -6),
		BackgroundColor3 = Color3.fromRGB(35, 35, 35),
		BorderSizePixel = 0,
		Parent = topBar,
	})

	local titleLabel = create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -68, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = topBar,
	})

	-- Power button used to close (destroy) the whole GUI, sits left of the arrow button
	local powerButton = create("TextButton", {
		Name = "PowerButton",
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(1, -56, 0, 2),
		BackgroundTransparency = 1,
		Text = "X",
		TextColor3 = Color3.fromRGB(255, 90, 90),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		Parent = topBar,
	})

	-- Arrow button used to expand/collapse the box
	local arrowButton = create("TextButton", {
		Name = "ArrowButton",
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(1, -28, 0, 2),
		BackgroundTransparency = 1,
		Text = "▼",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		Parent = topBar,
	})

	----------------------------------------------------------------
	-- "Close GUI?" confirmation dialog (Yes / No)
	-- Sits on top of the GUI's own area (follows the main box around
	-- and stays over it even when collapsed/dragged), not the whole screen
	----------------------------------------------------------------
	local confirmOverlay = create("Frame", {
		Name = "ConfirmOverlay",
		Size = mainFrame.Size,
		Position = mainFrame.Position,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 50,
		Parent = screenGui,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = confirmOverlay })

	-- Keep the overlay glued to the main box's current position/size
	local function syncConfirmOverlay()
		confirmOverlay.Position = mainFrame.Position
		confirmOverlay.Size = mainFrame.Size
	end
	mainFrame:GetPropertyChangedSignal("Position"):Connect(syncConfirmOverlay)
	mainFrame:GetPropertyChangedSignal("Size"):Connect(syncConfirmOverlay)

	local confirmBox = create("Frame", {
		Name = "ConfirmBox",
		Size = UDim2.new(0, 220, 0, 110),
		Position = UDim2.new(0.5, -110, 0.5, -55),
		BackgroundColor3 = Color3.fromRGB(25, 25, 25),
		BorderSizePixel = 0,
		ZIndex = 51,
		Parent = confirmOverlay,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = confirmBox })
	create("UIStroke", {
		Color = Color3.fromRGB(60, 60, 60),
		Thickness = 1,
		Parent = confirmBox,
	})

	create("TextLabel", {
		Name = "Message",
		Size = UDim2.new(1, -20, 0, 60),
		Position = UDim2.new(0, 10, 0, 12),
		BackgroundTransparency = 1,
		Text = "Are you sure you want to close the GUI?",
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		ZIndex = 51,
		Parent = confirmBox,
	})

	local noButton = create("TextButton", {
		Name = "NoButton",
		Size = UDim2.new(0.5, -16, 0, 32),
		Position = UDim2.new(0, 10, 1, -42),
		BackgroundColor3 = Color3.fromRGB(50, 50, 50),
		Text = "No",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		ZIndex = 51,
		Parent = confirmBox,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = noButton })

	local yesButton = create("TextButton", {
		Name = "YesButton",
		Size = UDim2.new(0.5, -16, 0, 32),
		Position = UDim2.new(0.5, 6, 1, -42),
		BackgroundColor3 = Color3.fromRGB(170, 45, 45),
		Text = "Yes",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		ZIndex = 51,
		Parent = confirmBox,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = yesButton })

	noButton.MouseEnter:Connect(function()
		noButton.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
	end)
	noButton.MouseLeave:Connect(function()
		noButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	end)
	yesButton.MouseEnter:Connect(function()
		yesButton.BackgroundColor3 = Color3.fromRGB(195, 55, 55)
	end)
	yesButton.MouseLeave:Connect(function()
		yesButton.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
	end)

	powerButton.MouseButton1Click:Connect(function()
		confirmOverlay.Visible = true
	end)

	noButton.MouseButton1Click:Connect(function()
		-- Nothing happens, life goes on as usual
		confirmOverlay.Visible = false
	end)

	yesButton.MouseButton1Click:Connect(function()
		-- Destroy the entire GUI
		screenGui:Destroy()
	end)

	-- Tab bar (tab buttons) — scrolls horizontally if there are too many tabs to fit
	local tabBar = create("ScrollingFrame", {
		Name = "TabBar",
		Size = UDim2.new(1, 0, 0, TABBAR_HEIGHT),
		Position = UDim2.new(0, 0, 0, TOPBAR_HEIGHT),
		BackgroundColor3 = Color3.fromRGB(28, 28, 28),
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(90, 90, 90),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		Parent = mainFrame,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
		Parent = tabBar,
	})

	-- Area where the selected tab's content is shown
	local contentContainer = create("Frame", {
		Name = "ContentContainer",
		Size = UDim2.new(1, 0, 1, -TOPBAR_HEIGHT - TABBAR_HEIGHT),
		Position = UDim2.new(0, 0, 0, TOPBAR_HEIGHT + TABBAR_HEIGHT),
		BackgroundTransparency = 1,
		Parent = mainFrame,
	})

	----------------------------------------------------------------
	-- Dragging from the top bar
	----------------------------------------------------------------
	do
		local dragging = false
		local dragStart
		local startPos

		topBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = mainFrame.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				mainFrame.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	----------------------------------------------------------------
	-- Window object
	----------------------------------------------------------------
	local self = setmetatable({}, Library)
	self.ScreenGui = screenGui
	self.MainFrame = mainFrame
	self.TitleLabel = titleLabel
	self.TabBar = tabBar
	self.ContentContainer = contentContainer
	self.Tabs = {}
	self.SelectedTab = nil
	self.Collapsed = false
	self.OpenHeight = DEFAULT_HEIGHT

	-- Expand/collapse button: when collapsed, only the top bar is shown
	-- (tab bar and content are hidden entirely so they take up zero space)
	arrowButton.MouseButton1Click:Connect(function()
		self.Collapsed = not self.Collapsed

		if self.Collapsed then
			arrowButton.Text = "▲"

			tabBar.Visible = false
			contentContainer.Visible = false

			TweenService:Create(mainFrame, TweenInfo.new(0.2), {
				Size = UDim2.new(0, mainFrame.Size.X.Offset, 0, TOPBAR_HEIGHT),
			}):Play()
		else
			arrowButton.Text = "▼"

			local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2), {
				Size = UDim2.new(0, mainFrame.Size.X.Offset, 0, self.OpenHeight),
			})

			-- Show the tab bar/content again once the box has finished expanding
			tween.Completed:Connect(function()
				if not self.Collapsed then
					tabBar.Visible = true
					contentContainer.Visible = true
				end
			end)

			tween:Play()
		end
	end)

	----------------------------------------------------------------
	-- Change the title: Window:SetTitle("New name")
	----------------------------------------------------------------
	function self:SetTitle(newTitle)
		titleLabel.Text = newTitle
	end

	----------------------------------------------------------------
	-- Tab selection
	----------------------------------------------------------------
	local function selectTab(tab)
		if self.SelectedTab then
			self.SelectedTab.Page.Visible = false
			self.SelectedTab.Button.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		end
		tab.Page.Visible = true
		tab.Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		self.SelectedTab = tab
	end

	----------------------------------------------------------------
	-- Window.Create table: Window.Create:Tab("Name")
	----------------------------------------------------------------
	self.Create = {}

	function self.Create.Tab(_self, name)
		local tab = {}
		tab.Name = name
		tab.ElementCount = 0

		local button = create("TextButton", {
			Name = name .. "Button",
			Size = UDim2.new(0, 70, 1, 0),
			BackgroundColor3 = Color3.fromRGB(28, 28, 28),
			BorderSizePixel = 0,
			Text = name,
			TextColor3 = Color3.fromRGB(230, 230, 230),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			LayoutOrder = #self.Tabs + 1,
			Parent = tabBar,
		})

		local page = create("ScrollingFrame", {
			Name = name .. "Page",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			Visible = false,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = contentContainer,
		})
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = page,
		})
		create("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			Parent = page,
		})

		tab.Button = button
		tab.Page = page

		-- Tab.Create table: Tab.Create:Button("Name", callback)
		tab.Create = {}

		function tab.Create.Button(_tab, buttonName, callback)
			tab.ElementCount += 1

			local btn = create("TextButton", {
				Name = buttonName .. "_Button",
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = Color3.fromRGB(45, 45, 45),
				Text = buttonName,
				TextColor3 = Color3.fromRGB(255, 255, 255),
				Font = Enum.Font.Gotham,
				TextSize = 13,
				LayoutOrder = tab.ElementCount,
				Parent = page,
			})
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = btn })

			btn.MouseEnter:Connect(function()
				btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			end)
			btn.MouseLeave:Connect(function()
				btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			end)

			btn.MouseButton1Click:Connect(function()
				if callback then
					local ok, err = pcall(callback)
					if not ok then
						warn("[GuiLibrary] Error in button '" .. buttonName .. "' callback: " .. tostring(err))
					end
				end
			end)

			return btn
		end

		----------------------------------------------------------------
		-- Tab.Create:Toggle("Name", default, callback)
		-- callback receives the new boolean state every time it's clicked
		----------------------------------------------------------------
		function tab.Create.Toggle(_tab, toggleName, default, callback)
			tab.ElementCount += 1

			local state = default and true or false

			local holder = create("Frame", {
				Name = toggleName .. "_Toggle",
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = Color3.fromRGB(45, 45, 45),
				LayoutOrder = tab.ElementCount,
				Parent = page,
			})
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = holder })

			local label = create("TextLabel", {
				Name = "Label",
				Size = UDim2.new(1, -50, 1, 0),
				Position = UDim2.new(0, 10, 0, 0),
				BackgroundTransparency = 1,
				Text = toggleName,
				TextColor3 = Color3.fromRGB(255, 255, 255),
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = holder,
			})

			-- Switch-style track
			local track = create("Frame", {
				Name = "Track",
				Size = UDim2.new(0, 36, 0, 18),
				Position = UDim2.new(1, -46, 0.5, -9),
				BackgroundColor3 = state and Color3.fromRGB(70, 160, 90) or Color3.fromRGB(70, 70, 70),
				BorderSizePixel = 0,
				Parent = holder,
			})
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

			local knob = create("Frame", {
				Name = "Knob",
				Size = UDim2.new(0, 14, 0, 14),
				Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				Parent = track,
			})
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

			local clickButton = create("TextButton", {
				Name = "ClickArea",
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				Parent = holder,
			})

			local function setState(newState, fireCallback)
				state = newState

				TweenService:Create(track, TweenInfo.new(0.15), {
					BackgroundColor3 = state and Color3.fromRGB(70, 160, 90) or Color3.fromRGB(70, 70, 70),
				}):Play()

				TweenService:Create(knob, TweenInfo.new(0.15), {
					Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				}):Play()

				if fireCallback and callback then
					local ok, err = pcall(callback, state)
					if not ok then
						warn("[GuiLibrary] Error in toggle '" .. toggleName .. "' callback: " .. tostring(err))
					end
				end
			end

			clickButton.MouseButton1Click:Connect(function()
				setState(not state, true)
			end)

			-- Fire the callback once up front with the default value
			if default ~= nil then
				setState(state, true)
			end

			return {
				Instance = holder,
				SetState = function(_, newState)
					setState(newState, true)
				end,
				GetState = function()
					return state
				end,
			}
		end

		----------------------------------------------------------------
		-- Tab.Create:Slider("Name", min, max, default, callback)
		-- callback receives the new numeric value every time it changes
		----------------------------------------------------------------
		function tab.Create.Slider(_tab, sliderName, min, max, default, callback)
			tab.ElementCount += 1

			min = min or 0
			max = max or 100
			local value = math.clamp(default or min, min, max)

			local holder = create("Frame", {
				Name = sliderName .. "_Slider",
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundColor3 = Color3.fromRGB(45, 45, 45),
				LayoutOrder = tab.ElementCount,
				Parent = page,
			})
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = holder })

			local label = create("TextLabel", {
				Name = "Label",
				Size = UDim2.new(1, -20, 0, 20),
				Position = UDim2.new(0, 10, 0, 4),
				BackgroundTransparency = 1,
				Text = sliderName .. ": " .. tostring(value),
				TextColor3 = Color3.fromRGB(255, 255, 255),
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = holder,
			})

			-- Track (background bar)
			local track = create("Frame", {
				Name = "Track",
				Size = UDim2.new(1, -20, 0, 6),
				Position = UDim2.new(0, 10, 1, -16),
				BackgroundColor3 = Color3.fromRGB(70, 70, 70),
				BorderSizePixel = 0,
				Parent = holder,
			})
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

			-- Fill (colored progress bar)
			local fill = create("Frame", {
				Name = "Fill",
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Color3.fromRGB(90, 140, 220),
				BorderSizePixel = 0,
				Parent = track,
			})
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

			-- Knob (draggable handle)
			local knob = create("Frame", {
				Name = "Knob",
				Size = UDim2.new(0, 14, 0, 14),
				Position = UDim2.new(0, -7, 0.5, -7),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = track,
			})
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

			-- Invisible button covering the track (with extra vertical hitbox), used to detect click/drag input
			local clickArea = create("TextButton", {
				Name = "ClickArea",
				Size = UDim2.new(1, 0, 0, 20),
				Position = UDim2.new(0, 0, 0.5, -10),
				BackgroundTransparency = 1,
				Text = "",
				Parent = track,
			})

			local function updateVisual()
				local percent = (value - min) / (max - min)
				fill.Size = UDim2.new(percent, 0, 1, 0)
				knob.Position = UDim2.new(percent, -7, 0.5, -7)
				label.Text = sliderName .. ": " .. tostring(value)
			end

			local function setValue(newValue, fireCallback)
				value = math.clamp(math.floor(newValue + 0.5), min, max)
				updateVisual()

				if fireCallback and callback then
					local ok, err = pcall(callback, value)
					if not ok then
						warn("[GuiLibrary] Error in slider '" .. sliderName .. "' callback: " .. tostring(err))
					end
				end
			end

			local function setValueFromPosition(inputPositionX)
				local trackPos = track.AbsolutePosition.X
				local trackSize = track.AbsoluteSize.X
				local percent = 0
				if trackSize > 0 then
					percent = math.clamp((inputPositionX - trackPos) / trackSize, 0, 1)
				end
				setValue(min + (max - min) * percent, true)
			end

			local dragging = false

			clickArea.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setValueFromPosition(input.Position.X)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					setValueFromPosition(input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			-- Set the visuals/fire the callback once up front with the default value
			setValue(value, true)

			return {
				Instance = holder,
				SetValue = function(_, newValue)
					setValue(newValue, true)
				end,
				GetValue = function()
					return value
				end,
			}
		end

		button.MouseButton1Click:Connect(function()
			selectTab(tab)
		end)

		table.insert(self.Tabs, tab)

		if #self.Tabs == 1 then
			selectTab(tab)
		end

		return tab
	end

	function self:GetTab(name)
		for _, tab in ipairs(self.Tabs) do
			if tab.Name == name then
				return tab
			end
		end
		return nil
	end

	return self
end

