ManualTab.Create:Button("Teleport to Game", function()

    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local character = LocalPlayer.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return
    end

    -- ======================
    -- Tarkista onko itsellä Knife
    -- ======================

    local hasOwnKnife = false

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local characterKnife = character:FindFirstChild("Knife")
    local backpackKnife = backpack and backpack:FindFirstChild("Knife")

    if (characterKnife and characterKnife:IsA("Tool"))
        or (backpackKnife and backpackKnife:IsA("Tool")) then

        hasOwnKnife = true
    end

    -- ======================
    -- Etsi Coin_Serverit
    -- ======================

    local coins = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" then

            local position = nil

            if obj:IsA("BasePart") then
                position = obj.Position

            elseif obj:IsA("Model") then
                position = obj:GetPivot().Position
            end

            if position then
                table.insert(coins, {
                    object = obj,
                    position = position
                })
            end
        end
    end

    if #coins == 0 then
        warn("Teleport to Game: Coin_Server ei löytynyt!")
        return
    end

    -- ======================
    -- Jos itsellä on Knife
    -- ======================

    if hasOwnKnife then

        -- Teleporttaa johonkin Coin_Serveriin
        local target = coins[math.random(1, #coins)]

        myRoot.CFrame =
            CFrame.new(target.position + Vector3.new(0, 3, 0))

        return
    end

    -- ======================
    -- Etsi muut Knife-pelaajat
    -- ======================

    local knifePlayers = {}

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            local playerCharacter = player.Character
            local playerBackpack = player:FindFirstChild("Backpack")

            local knifeInCharacter =
                playerCharacter
                and playerCharacter:FindFirstChild("Knife")

            local knifeInBackpack =
                playerBackpack
                and playerBackpack:FindFirstChild("Knife")

            if (knifeInCharacter and knifeInCharacter:IsA("Tool"))
                or (knifeInBackpack and knifeInBackpack:IsA("Tool")) then

                local root =
                    playerCharacter
                    and playerCharacter:FindFirstChild("HumanoidRootPart")

                if root then
                    table.insert(knifePlayers, root)
                end
            end
        end
    end

    -- Ei Knife-pelaajia
    if #knifePlayers == 0 then
        warn("Teleport to Game: Knife-pelaajaa ei löytynyt!")
        return
    end

    -- ======================
    -- Valitse Coin_Server,
    -- joka on kauimpana Knife-pelaajista
    -- ======================

    local bestCoin = nil
    local bestDistance = -math.huge

    for _, coin in ipairs(coins) do

        local nearestKnifeDistance = math.huge

        for _, knifeRoot in ipairs(knifePlayers) do

            local distance =
                (coin.position - knifeRoot.Position).Magnitude

            if distance < nearestKnifeDistance then
                nearestKnifeDistance = distance
            end
        end

        if nearestKnifeDistance > bestDistance then
            bestDistance = nearestKnifeDistance
            bestCoin = coin
        end
    end

    -- ======================
    -- Teleport
    -- ======================

    if bestCoin then
        myRoot.CFrame =
            CFrame.new(bestCoin.position + Vector3.new(0, 3, 0))
    end

end)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local DodgeEnabled = false
local DodgeConnection = nil

local function GetCharacter()
    return Player.Character
end

local function GetRoot()
    local Character = GetCharacter()
    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function FindKnifeVisual()
    -- Skannaa KOKO Workspacen, myös ThrowingKnife-modelien sisältä
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object.Name == "KnifeVisual" then

            -- KnifeVisual voi olla BasePart
            if Object:IsA("BasePart") then
                return Object
            end

            -- Tai Model
            if Object:IsA("Model") then
                local Part = Object.PrimaryPart
                    or Object:FindFirstChildWhichIsA("BasePart", true)

                if Part then
                    return Part
                end
            end
        end
    end

    return nil
end

local function Dodge()
    if not DodgeEnabled then
        return
    end

    local Character = GetCharacter()
    local Root = GetRoot()

    if not Character or not Root then
        return
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    -- Etsitään KnifeVisual joka tickillä
    local KnifeVisual = FindKnifeVisual()

    if not KnifeVisual or not KnifeVisual.Parent then
        return
    end

    -- 20 studin tarkistus
    local Distance = (Root.Position - KnifeVisual.Position).Magnitude

    if Distance > 20 then
        return
    end

    -- Haetaan Parts uudelleen joka kerta
    local Parts = workspace:FindFirstChild("RegularLobby")

    if not Parts then
        return
    end

    Parts = Parts:FindFirstChild("MainLobby")

    if not Parts then
        return
    end

    Parts = Parts:FindFirstChild("Parts")

    if not Parts then
        return
    end

    local Children = Parts:GetChildren()
    local Target = Children[175]

    if not Target or not Target:IsA("BasePart") then
        return
    end

    -- Live CFrame juuri sillä hetkellä
    Root.CFrame = Target.CFrame
end

local function StartDodge()
    if DodgeConnection then
        DodgeConnection:Disconnect()
    end

    DodgeConnection = RunService.Heartbeat:Connect(function()
        if DodgeEnabled then
            Dodge()
        end
    end)
end

