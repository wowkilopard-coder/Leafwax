local function clearHighlights(highlightTable)
	for _, highlight in pairs(highlightTable) do
		if highlight and highlight.Parent then
			highlight:Destroy()
		end
	end
	table.clear(highlightTable)
end

local function createHighlight(character, color, tableRef, player)
	if not character then return end

	-- Poista vanha jos on
	if tableRef[player] then
		tableRef[player]:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Highlight"
	highlight.Adornee = character
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	tableRef[player] = highlight
end

-- ======================
-- Name ESP (kaikille pelaajille)
-- ======================

local nameEnabled = false
local nameConnection = nil
local nameLabels = {} -- [Player] = BillboardGui
local playerConnections = {} -- [Player] = {connections}

local function removeNameLabel(player)
    local gui = nameLabels[player]

    if gui then
        gui:Destroy()
        nameLabels[player] = nil
    end
end

local function clearNameLabels()
    for player in pairs(nameLabels) do
        removeNameLabel(player)
    end
end

local function createNameLabel(character, player)
    if not nameEnabled then return end
    if not character or not player then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    -- Jos samaan hahmoon on jo luotu nimi, ei tehdä uutta
    local old = nameLabels[player]
    if old and old.Parent == head then
        return
    end

    -- Poista vanha nimilappu
    removeNameLabel(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 2000
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Name = "NameLabel"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = player.Name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextScaled = false
    label.Parent = billboard

    nameLabels[player] = billboard
end

local function setupPlayer(player)
    if playerConnections[player] then return end

    playerConnections[player] = {}

    local connections = playerConnections[player]

    -- Hahmo ilmestyy tai vaihtuu
    table.insert(connections, player.CharacterAdded:Connect(function(character)
        if not nameEnabled then return end

        removeNameLabel(player)

        -- Odotetaan pään latautumista
        task.spawn(function()
            local head = character:WaitForChild("Head", 10)

            if not nameEnabled then return end
            if player.Character ~= character then return end
            if not head then return end

            createNameLabel(character, player)
        end)
    end))

    -- Hahmo poistuu, esimerkiksi kuollessa
    table.insert(connections, player.CharacterRemoving:Connect(function(character)
        local gui = nameLabels[player]

        if gui and gui.Adornee
            and gui.Adornee:IsDescendantOf(character) then
            removeNameLabel(player)
        end
    end))

    -- Pelaajalla voi olla hahmo jo valmiiksi
    if player.Character then
        task.spawn(function()
            local character = player.Character
            local head = character:WaitForChild("Head", 10)

            if nameEnabled
                and player.Character == character
                and head then
                createNameLabel(character, player)
            end
        end)
    end
end

local function removePlayer(player)
    removeNameLabel(player)

    if playerConnections[player] then
        for _, connection in ipairs(playerConnections[player]) do
            connection:Disconnect()
        end

        playerConnections[player] = nil
    end
end

EspTab.Create:Toggle("Name ESP", false, function(enabled)
    nameEnabled = enabled

    if enabled then
        -- Lisää kaikki nykyiset pelaajat
        for _, player in ipairs(Players:GetPlayers()) do
            setupPlayer(player)
        end

        -- Uudet pelaajat
        nameConnection = Players.PlayerAdded:Connect(function(player)
            if nameEnabled then
                setupPlayer(player)
            end
        end)

        -- Poistuvat pelaajat
        local removingConnection = Players.PlayerRemoving:Connect(function(player)
            removePlayer(player)
        end)

        -- Säilytetään myös tämä yhteys
        table.insert(playerConnections, removingConnection)

    else
        -- Katkaise pelaajien seuranta
        if nameConnection then
            nameConnection:Disconnect()
            nameConnection = nil
        end

        -- Poista kaikki nimilaput
        clearNameLabels()

        -- Katkaise kaikki pelaajakohtaiset yhteydet
        for player, connections in pairs(playerConnections) do
            for _, connection in ipairs(connections) do
                connection:Disconnect()
            end

            playerConnections[player] = nil
        end
    end
end)

