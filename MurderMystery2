local TELEPORT_DELAY = 1.5 -- Seconds between each coin teleport

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local coinFarmEnabled = false
local collectedCoins = {}

local startCFrame = workspace.RegularLobby.MainLobby.Parts:GetChildren()[175].CFrame

local function getRoot()
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	return character:WaitForChild("HumanoidRootPart")
end

AutofarmTab.Create:Toggle("Coin farm", false, function(enabled)
	coinFarmEnabled = enabled

	if not enabled then
		return
	end

	task.spawn(function()
		while coinFarmEnabled do
			local root = getRoot()

			if not root.Parent then
				task.wait()
				continue
			end

			root.CFrame = startCFrame

			local coins = {}

			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not collectedCoins[obj] then
					table.insert(coins, obj)
				end
			end

			if #coins == 0 then
				collectedCoins = {}
				task.wait(1)
				continue
			end

			-- Choose the coin furthest away from other players.
			local bestCoin
			local bestDistance = -math.huge

			for _, coin in ipairs(coins) do
				local closestDistance = math.huge

				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer then
						local character = plr.Character
						local otherRoot = character and character:FindFirstChild("HumanoidRootPart")

						if otherRoot then
							local distance = (coin.Position - otherRoot.Position).Magnitude
							if distance < closestDistance then
								closestDistance = distance
							end
						end
					end
				end

				if closestDistance > bestDistance then
					bestDistance = closestDistance
					bestCoin = coin
				end
			end

			local coin = bestCoin or coins[math.random(#coins)]
			collectedCoins[coin] = true

			root = getRoot()

			if not coinFarmEnabled then
				return
			end

			root.CFrame = coin.CFrame + Vector3.new(0, 2, 0)

			-- Small up/down movement to ensure the coin is collected.
			for i = 1, 4 do
				if not coinFarmEnabled then
					return
				end

				if not root.Parent then
					break
				end

				root.CFrame = coin.CFrame + Vector3.new(0, 3, 0)
				task.wait(0.08)

				if not root.Parent then
					break
				end

				root.CFrame = coin.CFrame + Vector3.new(0, 1, 0)
				task.wait(0.08)
			end

			if not coinFarmEnabled then
				return
			end

			root = getRoot()

			if root.Parent then
				root.CFrame = startCFrame
			end

			local elapsed = 0
			while coinFarmEnabled and elapsed < TELEPORT_DELAY do
				task.wait(0.1)
				elapsed += 0.1
			end
		end
	end)
end)

