local autoShootConnection = nil

AutofarmTab.Create:Toggle("Auto Shoot if Sheriff", false, function(enabled)
	if enabled then
		if autoShootConnection then autoShootConnection:Disconnect() end

		autoShootConnection = RunService.Heartbeat:Connect(function()
			local character = LocalPlayer.Character
			if not character then return end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then return end

			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			-- Etsi Gun backpackista tai hahmosta
			local gun = LocalPlayer.Backpack:FindFirstChild("Gun") 
				or character:FindFirstChild("Gun")

			if not gun then return end

			-- Ota Gun käteen jos se on backpackissa
			if gun.Parent == LocalPlayer.Backpack then
				humanoid:EquipTool(gun)
			end

			-- Etsi pelaaja jolla on Knife (Murderer)
			local targetPlayer = nil
			local targetRoot = nil
			local targetTorso = nil

			for _, player in pairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local knife = player.Backpack:FindFirstChild("Knife") 
						or player.Character:FindFirstChild("Knife")

					if knife then
						targetPlayer = player
						targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
						targetTorso = player.Character:FindFirstChild("Torso") 
							or player.Character:FindFirstChild("UpperTorso")
						break
					end
				end
			end

			if not targetRoot or not targetTorso then return end

			-- Teleportataan oma hahmo 20 studin päähän kohteen taakse
			local targetLookDirection = targetRoot.CFrame.LookVector
			local behindPosition = targetRoot.Position - (targetLookDirection * 20) + Vector3.new(0, 0.5, 0)
			root.CFrame = CFrame.lookAt(behindPosition, targetTorso.Position)

			-- ETSITÄÄN REMOTE EVENT
			local shootRemote = gun:FindFirstChild("Shoot")
			if shootRemote and shootRemote:IsA("RemoteEvent") then
				-- Vastaus kysymykseesi: Lähtöpiste EI tarvitse olla aseessa!
				-- Asetetaan luoti alkamaan 2 studiyksikköä kohteen takaa ja päättymään 2 studiyksikköä kohteen eteen.
				-- Tämä saa luodin kulkemaan suoraan kohteen läpi seinistä ja esteistä välittämättä.
				
				local direction = targetLookDirection -- Käytetään kohteen omaa suuntaa lävistykseen
				local targetStart = targetTorso.Position - (direction * 2)
				local targetEnd = targetTorso.Position + (direction * 2)

				local lookCFrame = CFrame.lookAt(targetStart, targetEnd)
				local hitCFrame  = CFrame.new(targetEnd)

				-- Lähetetään käsky suoraan palvelimelle ohittaen hiiren ja kameran
				shootRemote:FireServer(lookCFrame, hitCFrame)
			else
				-- Vaihtoehtoinen varmistus, jos peli käyttää perinteistä aseen aktivointia
				gun:Activate()
			end
		end)
	else
		if autoShootConnection then
			autoShootConnection:Disconnect()
			autoShootConnection = nil
		end
	end
end)


local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local autoGunConnection = nil
local descendantAddedConnection = nil
local gunDrop = nil
local lastSearch = 0
local lastPickup = 0
local SEARCH_INTERVAL = 0.5
local PICKUP_INTERVAL = 0.15

AutofarmTab.Create:Toggle("Auto Gun Pickup", false, function(enabled)
	if enabled then
		-- Etsi olemassa olevat guns
		for _, obj in pairs(Workspace:GetDescendants()) do
			if obj.Name == "GunDrop" then
				gunDrop = obj
				break
			end
		end

		-- Kuuntele uusia gunseja
		descendantAddedConnection = Workspace.DescendantAdded:Connect(function(obj)
			if obj.Name == "GunDrop" then
				gunDrop = obj
			end
		end)

		autoGunConnection = RunService.Heartbeat:Connect(function()
			local character = LocalPlayer.Character
			if not character then return end

			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local currentTick = tick()

			-- Hae gunia harvemmin
			if currentTick - lastSearch > SEARCH_INTERVAL then
				lastSearch = currentTick

				if gunDrop and not gunDrop.Parent then
					gunDrop = nil
				end

				if not gunDrop then
					for _, obj in pairs(Workspace:GetDescendants()) do
						if obj.Name == "GunDrop" then
							gunDrop = obj
							break
						end
					end
				end
			end

			-- Poimi gunia harvemmin (ei joka frame)
			if gunDrop and gunDrop.Parent and (currentTick - lastPickup) > PICKUP_INTERVAL then
				lastPickup = currentTick
				pcall(function()
					firetouchinterest(root, gunDrop, 0)
					firetouchinterest(root, gunDrop, 1)
				end)
			end
		end)
	else
		-- Kunnollinen cleanup
		if autoGunConnection then
			autoGunConnection:Disconnect()
			autoGunConnection = nil
		end
		if descendantAddedConnection then
			descendantAddedConnection:Disconnect()
			descendantAddedConnection = nil
		end
		gunDrop = nil
	end
end)

