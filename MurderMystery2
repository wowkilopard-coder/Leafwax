    DodgeEnabled = State

    if DodgeConnection then
        DodgeConnection:Disconnect()
        DodgeConnection = nil
    end

    if DodgeEnabled then
        StartDodge()
    end
end)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local reachEnabled = false
local originalData = {} -- {Size = ..., CanCollide = ...}
local connections = {}

local function setReach(character, size)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then
        if not originalData[hrp] then
            originalData[hrp] = {
                Size = hrp.Size,
                CanCollide = hrp.CanCollide
            }
        end
        hrp.Size = size
        hrp.CanCollide = false
    end
end

local function restoreReach(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and originalData[hrp] then
        hrp.Size = originalData[hrp].Size
        hrp.CanCollide = originalData[hrp].CanCollide
        originalData[hrp] = nil
    end
end

local function applyToPlayer(player)
    if player == LocalPlayer then return end

    local function onCharacter(character)
        if not reachEnabled then return end
        task.wait(0.1)
        setReach(character, Vector3.new(30, 30, 30))
    end

    if player.Character then
        onCharacter(player.Character)
    end

    connections[player] = player.CharacterAdded:Connect(onCharacter)
end

local function removeFromPlayer(player)
    if connections[player] then
        connections[player]:Disconnect()
        connections[player] = nil
    end
    if player.Character then
        restoreReach(player.Character)
    end
end

ManualTab.Create:Toggle("Reach (Knife)", false, function(enabled)
    reachEnabled = enabled

    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            applyToPlayer(player)
        end

        connections.PlayerAdded = Players.PlayerAdded:Connect(applyToPlayer)
        connections.PlayerRemoving = Players.PlayerRemoving:Connect(removeFromPlayer)
    else
        for _, player in ipairs(Players:GetPlayers()) do
            removeFromPlayer(player)
        end

        if connections.PlayerAdded then
            connections.PlayerAdded:Disconnect()
            connections.PlayerAdded = nil
        end
        if connections.PlayerRemoving then
            connections.PlayerRemoving:Disconnect()
            connections.PlayerRemoving = nil
        end

        table.clear(originalData)
    end
end)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local aimbotEnabled = false
local aimbotConnection = nil
local currentTarget = nil
local lastShot = 0
local shotCooldown = 0.08
local knifeConnections = {}

local function clearTarget()
	currentTarget = nil
end

local function isValidTarget(player)
	if not player or not player.Character then return false end
	if player == LocalPlayer then return false end

	local hasKnife = player.Character:FindFirstChild("Knife") 
		or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife"))

	return hasKnife ~= nil
end

local function setupPlayer(player)
	if player == LocalPlayer then return end

	local function onCharacter(character)
		-- Kuuntele kun Knife lisätään characteriin
		local charConn = character.ChildAdded:Connect(function(child)
			if child.Name == "Knife" and aimbotEnabled then
				currentTarget = player
			end
		end)

		-- Kuuntele kun Knife poistetaan
		local charRemConn = character.ChildRemoved:Connect(function(child)
			if child.Name == "Knife" and currentTarget == player then
				clearTarget()
			end
		end)

		table.insert(knifeConnections, charConn)
		table.insert(knifeConnections, charRemConn)
	end

	if player.Character then
		onCharacter(player.Character)
	end

	local charAddedConn = player.CharacterAdded:Connect(onCharacter)
	table.insert(knifeConnections, charAddedConn)

	-- Backpack
	local function setupBackpack(backpack)
		local addConn = backpack.ChildAdded:Connect(function(child)
			if child.Name == "Knife" and aimbotEnabled then
				currentTarget = player
			end
		end)
		local remConn = backpack.ChildRemoved:Connect(function(child)
			if child.Name == "Knife" and currentTarget == player then
				clearTarget()
			end
		end)
		table.insert(knifeConnections, addConn)
		table.insert(knifeConnections, remConn)
	end

	if player:FindFirstChild("Backpack") then
		setupBackpack(player.Backpack)
	end

	local backpackAdded = player.ChildAdded:Connect(function(child)
		if child.Name == "Backpack" then
			setupBackpack(child)
		end
	end)
	table.insert(knifeConnections, backpackAdded)
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local aimbotEnabled = false
local aimbotConnection = nil
local lastShot = 0
local shotCooldown = 0.08

local function hasKnife(player)
	if not player or not player.Character then return false end
	if player.Character:FindFirstChild("Knife") then return true end
	local backpack = player:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild("Knife") then return true end
	return false
end

local function getGun()
	local character = LocalPlayer.Character
	if not character then return nil end
	local gun = character:FindFirstChild("Gun")
	if gun and gun:IsA("Tool") then
		return gun
	end
	return nil
end

local function getClosestKnifePlayer()
	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end

	local myHRP = character.HumanoidRootPart
	local closest, closestDist = nil, math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and hasKnife(player) then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local dist = (hrp.Position - myHRP.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = player
				end
			end
		end
	end
	return closest
end

local function hasLineOfSight(origin, targetPos, targetCharacter)
	local direction = targetPos - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LocalPlayer.Character}
	params.IgnoreWater = true

	local result = workspace:Raycast(origin, direction, params)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(targetCharacter)
end

local function silentShoot()
	local now = tick()
	if now - lastShot < shotCooldown then return end

	local gun = getGun()
	if not gun then return end

	local shootRemote = gun:FindFirstChild("Shoot")
	if not shootRemote or not shootRemote:IsA("RemoteEvent") then return end

	local target = getClosestKnifePlayer()
	if not target or not target.Character then return end

	local torso = target.Character:FindFirstChild("Torso") 
		or target.Character:FindFirstChild("UpperTorso")
		or target.Character:FindFirstChild("HumanoidRootPart")
	if not torso then return end

	local myCharacter = LocalPlayer.Character
	local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end

	-- Tarkistetaan suora näköyhteys omasta hahmosta kohteeseen (esteet tiellä?)
	local myOrigin = myHRP.Position
	if not hasLineOfSight(myOrigin, torso.Position, target.Character) then
		return
	end

	-- MUUTOS: Luoti ammutaan nyt alkamaan suoraan kohteen sisältä!
	-- Otetaan suunta sinusta kohteeseen
	local direction = (torso.Position - myOrigin).Unit

	-- Luoti alkaa 2 studiyksikköä kohteen takaa (suhteesi sinuun) ja menee 2 studiyksikköä kohteen läpi
	local targetStart = torso.Position - (direction * 2)
	local targetEnd = torso.Position + (direction * 2)

	local lookCFrame = CFrame.lookAt(targetStart, targetEnd)
	local hitCFrame  = CFrame.new(targetEnd)

	-- Lähetetään täydellinen osuma suoraan palvelimelle ilman hiiren kursorin vaikutusta
	shootRemote:FireServer(lookCFrame, hitCFrame)
	lastShot = now
end

