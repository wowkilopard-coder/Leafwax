local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = game.Players.LocalPlayer

local REVERSE_KMH = 20
local DECEL = 30
local TURN_SPEED = 1.5
local KMH_TO_STUDS = (1 / 3.6 * 5.6) / 1.42

local bv = nil
local bav = nil
local speed = 0
local lastDrag = nil

local function setupForces(drag)
	-- Poista vanhat
	if bv then bv:Destroy() end
	if bav then bav:Destroy() end

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(9999999, 0, 9999999)
	bv.P = 2000
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = drag

	bav = Instance.new("BodyAngularVelocity")
	bav.MaxTorque = Vector3.new(0, 9999999, 0)
	bav.AngularVelocity = Vector3.new(0, 0, 0)
	bav.P = 9999999
	bav.Parent = drag

	lastDrag = drag
end

RunService.Heartbeat:Connect(function(dt)
	if not CustomSpeedEnabled then
		if bv then bv.Velocity = Vector3.new(0, 0, 0) end
		if bav then bav.AngularVelocity = Vector3.new(0, 0, 0) end
		speed = 0
		return
	end

	-- Hae drag joka frame uudestaan jos vaihdettu
	local ok, car = pcall(function()
		return workspace[player.Name .. "sCar"]
	end)
	if not ok or not car then return end

	local ok2, drag = pcall(function()
		return car.Body.Drag
	end)
	if not ok2 or not drag then return end

	-- Resetoi forces jos drag vaihtui
	if drag ~= lastDrag then
		speed = 0
		setupForces(drag)
	end

	-- Laske arvot slidereiden mukaan joka frame
	local maxSpeed     = MAX_SPEED_KMH * KMH_TO_STUDS
	local reverseSpeed = REVERSE_KMH   * KMH_TO_STUDS
	local accelS       = ACCEL         * KMH_TO_STUDS
	local decelS       = DECEL         * KMH_TO_STUDS

	local flatLook = Vector3.new(drag.CFrame.LookVector.X, 0, drag.CFrame.LookVector.Z).Unit

	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		speed = math.min(speed + accelS * dt, maxSpeed)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		speed = math.max(speed - accelS * dt, -reverseSpeed)
	else
		if speed > 0 then
			speed = math.max(speed - decelS * dt, 0)
		elseif speed < 0 then
			speed = math.min(speed + decelS * dt, 0)
		end
	end

	bv.Velocity = flatLook * speed

	local speedFactor = math.abs(speed) / maxSpeed
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		bav.AngularVelocity = Vector3.new(0, TURN_SPEED * speedFactor, 0)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		bav.AngularVelocity = Vector3.new(0, -TURN_SPEED * speedFactor, 0)
	else
		bav.AngularVelocity = Vector3.new(0, 0, 0)
	end
end)

local WheelieEnabled = false
