local SPEED = 400
local FIXED_Y = 3.5

Tabs.Autofarm:AddButton({
	Title = "Start autofarm",
	Description = "Sit on vehicle before pressing. To stop autofarm just respawn your vehicle",
	Callback = function()

		local RunService = game:GetService("RunService")
		
		local player = game.Players.LocalPlayer
		local car = workspace[player.Name .. "sCar"]

		local WHEELIE_ANGLE = math.rad(25)

		local A = Vector3.new(344, FIXED_Y, 2533)
		local B = Vector3.new(343, FIXED_Y, -6961)

		local dirAB = (Vector3.new(B.X, 0, B.Z) - Vector3.new(A.X, 0, A.Z)).Unit
		local dirBA = -dirAB
		local yawAB = math.atan2(-dirAB.X, -dirAB.Z)
		local yawBA = math.atan2(-dirBA.X, -dirBA.Z)

		local currentPos = Vector3.new(A.X, FIXED_Y, A.Z)
		local currentDir = dirAB
		local currentYaw = yawAB
		local target = B

		RunService.Heartbeat:Connect(function(dt)
			local toTarget = Vector3.new(target.X - currentPos.X, 0, target.Z - currentPos.Z)

			if toTarget.Magnitude < SPEED * dt + 1 then
				if target == B then
					target = A
					currentDir = dirBA
					currentYaw = yawBA
				else
					target = B
					currentDir = dirAB
					currentYaw = yawAB
				end
				return
			end

			currentPos = currentPos + currentDir * SPEED * dt

			car:PivotTo(
				CFrame.new(currentPos)
					* CFrame.Angles(0, currentYaw, 0)
					* CFrame.Angles(WHEELIE_ANGLE, 0, 0)
			)
		end)
	end
})

