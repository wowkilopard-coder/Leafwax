local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

local WHEELIE_ANGLE = math.rad(25)

local gyro = nil
local lastDrag = nil

local function setupGyro(drag)
	if gyro then gyro:Destroy() end

	gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(9999999, 0, 9999999)
	gyro.P = 50000
	gyro.D = 2000
	gyro.CFrame = drag.CFrame
	gyro.Parent = drag

	lastDrag = drag
end

RunService.Heartbeat:Connect(function()
	-- Hae drag
	local ok, car = pcall(function() return workspace[player.Name .. "sCar"] end)
	if not ok or not car then return end
	local ok2, drag = pcall(function() return car.Body.Drag end)
	if not ok2 or not drag then return end

	if drag ~= lastDrag then
		setupGyro(drag)
	end

	if not WheelieEnabled then
		if gyro then gyro:Destroy() gyro = nil lastDrag = nil end
		return
	end

	if not gyro then setupGyro(drag) end

	local look = drag.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	gyro.CFrame = CFrame.new(drag.Position)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(WHEELIE_ANGLE, 0, 0)
end)

